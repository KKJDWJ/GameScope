<Window x:Class="Automation.UI.AoiPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick AOI"
        Width="980"
        Height="700"
        MinWidth="720"
        MinHeight="520"
        Background="#EEF2F6"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#2C4056" Padding="12" CornerRadius="6" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Text="Drag AOI On Target Capture" Foreground="White" FontSize="16" FontWeight="Bold" />
                <TextBlock x:Name="GuideText" Text="Drag a rectangle on the captured target window, then press OK." Foreground="#B9C7D7" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="CaptureCanvas" Background="#111827" MouseLeftButtonDown="CaptureCanvas_MouseLeftButtonDown" MouseMove="CaptureCanvas_MouseMove" MouseLeftButtonUp="CaptureCanvas_MouseLeftButtonUp">
                    <Image x:Name="CaptureImage" IsHitTestVisible="False" />
                    <Rectangle x:Name="SelectionRectangle" Stroke="#2F80C1" StrokeThickness="2" Fill="#402F80C1" Visibility="Collapsed" IsHitTestVisible="False" />
                </Canvas>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SelectionText" Text="Selection: none" VerticalAlignment="Center" Foreground="#4B5563" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="OK" Width="88" Height="30" IsEnabled="False" Click="OkButton_Click" />
                <Button Content="Cancel" Width="88" Height="30" Margin="8,0,0,0" Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
