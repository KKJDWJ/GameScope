<Window
    x:Class="Automation.UI.CapturePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Background Capture Test"
    Width="1000"
    Height="700"
    MinWidth="520"
    MinHeight="360"
    WindowStartupLocation="CenterOwner">
    <Grid Background="#EEF3F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="14,10" Background="#29425D">
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Windows Graphics Capture 결과" />
                <TextBlock
                    x:Name="DescriptionText"
                    Margin="0,3,0,0"
                    Foreground="#DCE8F4"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <Border Margin="10" Background="#111827">
                <Image x:Name="PreviewImage" Stretch="None" />
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
