<Window
    x:Class="Automation.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Automation.Core.Automation;assembly=Automation.Core"
    Title="GameScope AI"
    Width="1480"
    Height="780"
    MinWidth="1120"
    MinHeight="660"
    Background="#EEF2F6"
    FontFamily="Consolas">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#2C4056" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D9DEE6" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2F80C1" />

        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#C9D1DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#1F6EA8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#C9D1DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9DEE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="MinRowHeight" Value="32" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="ColumnHeaderHeight" Value="32" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EAF0" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderBrush" Value="#E5EAF0" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <Style x:Key="GridCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="2,0" />
        </Style>

        <Style x:Key="GridNumberTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F4F8" />
            <Setter Property="Foreground" Value="#263445" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#D9DEE6" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="LegacyVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility"
                    Value="{Binding IsChecked, ElementName=LegacyFeaturesToggle, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Style>

        <Style x:Key="CoreWorkspaceCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Grid.ColumnSpan" Value="5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LegacyFeaturesToggle}" Value="True">
                    <Setter Property="Grid.ColumnSpan" Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="GameScope AI" />
                    <TextBlock
                        Margin="1,2,0,0"
                        FontSize="11"
                        Foreground="#B9C7D7"
                        Text="Game Screen Analysis &amp; Vision Intelligence" />
                </StackPanel>

                <Border
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Padding="12,7"
                    VerticalAlignment="Center"
                    Background="#23364A"
                    BorderBrush="#41566C"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Workspace Ready" />
                </Border>

                <StackPanel
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox
                        x:Name="LegacyFeaturesToggle"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Content="Legacy 기능 표시"
                        IsChecked="False" />
                    <StackPanel Orientation="Horizontal" Style="{StaticResource LegacyVisibilityStyle}">
                        <Border
                            x:Name="MonitoringStatusBorder"
                            Width="88"
                            Height="30"
                            Margin="0"
                            VerticalAlignment="Center"
                            Background="#F5D3E1"
                            BorderBrush="#C9D1DC"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock
                                x:Name="MonitoringStatusText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#8B2044"
                                Text="정지" />
                        </Border>
                        <Button
                            x:Name="StartAllButton"
                            Width="88"
                            Click="StartAllButton_Click"
                            Content="전체 실행"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button
                            x:Name="StopAllButton"
                            Width="88"
                            Click="StopAllButton_Click"
                            Content="전체 정지"
                            IsEnabled="False" />
                    </StackPanel>
                    <Button Click="UserGuideButton_Click" Content="User Guide" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Background="#F7F9FC"
            BorderBrush="#CFD6E0"
            BorderThickness="0,0,0,1">
            <StackPanel Margin="2,0,0,0" Orientation="Horizontal">
                <Border
                    Width="130"
                    Background="#FFFFFF"
                    BorderBrush="#BFC7D1"
                    BorderThickness="1,0,1,1">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Targets" />
                </Border>
                <Border
                    Width="130"
                    BorderBrush="#CFD6E0"
                    BorderThickness="0,0,1,1">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="AOI / Vision" />
                </Border>
                <StackPanel Orientation="Horizontal" Style="{StaticResource LegacyVisibilityStyle}">
                    <Button
                        Width="130"
                        Height="42"
                        Margin="0"
                        BorderBrush="#CFD6E0"
                        Click="MacrosPageButton_Click"
                        Content="Macros" />
                    <Border
                        Width="130"
                        BorderBrush="#CFD6E0"
                        BorderThickness="0,0,1,1">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="Monitoring" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.95*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2.55*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Border Grid.ColumnSpan="5" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Border
                        Background="#EAF4FF"
                        BorderBrush="#D9DEE6"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0">
                        <TextBlock
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="#0068B7"
                            Text="Available Windows" />
                    </Border>
                    <DataGrid
                        x:Name="WindowGrid"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Title}"
                                ElementStyle="{StaticResource GridCellTextStyle}"
                                Header="Title" />
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding ClassName}"
                                ElementStyle="{StaticResource GridCellTextStyle}"
                                Header="Class" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel
                        Grid.Row="2"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Click="BackgroundCaptureButton_Click"
                            Content="Background Capture" />
                        <Button
                            Click="OfflineImageButton_Click"
                            Content="Offline Image"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Click="RefreshButton_Click" Content="Refresh" />
                        <Button
                            Click="AddTargetButton_Click"
                            Content="Add Target"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Border
                        Background="#E9F8EF"
                        BorderBrush="#D9DEE6"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0">
                        <TextBlock
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="#008A3D"
                            Text="Target List" />
                    </Border>
                    <DataGrid
                        x:Name="TargetGrid"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        IsReadOnly="False"
                        SelectionChanged="TargetGrid_SelectionChanged"
                        SelectionMode="Single">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivationState}" Value="Active">
                                        <Setter Property="Background" Value="#D9F2D9" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActivationState}" Value="Failed">
                                        <Setter Property="Background" Value="#F8D7E3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn
                                Width="45"
                                Binding="{Binding IsEnabled}"
                                ElementStyle="{StaticResource GridCheckBoxStyle}"
                                EditingElementStyle="{StaticResource GridCheckBoxStyle}"
                                Header="On" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Name}"
                                ElementStyle="{StaticResource GridCellTextStyle}"
                                Header="Name" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Title}"
                                ElementStyle="{StaticResource GridCellTextStyle}"
                                Header="Title"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel
                        Grid.Row="2"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button Click="ActivateButton_Click" Content="Activate" />
                        <Button Click="RemoveTargetButton_Click" Content="Remove" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Grid.Column="2"
                Style="{StaticResource CardBorderStyle}"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Border
                        Background="#E9F8EF"
                        BorderBrush="#D9DEE6"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0">
                        <TextBlock
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="#008A3D"
                            Text="AOI List For Selected Target" />
                    </Border>
                    <DataGrid
                        x:Name="AoiGrid"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        IsReadOnly="False"
                        MouseDoubleClick="AoiGrid_MouseDoubleClick"
                        SelectionChanged="AoiGrid_SelectionChanged"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn
                                Width="45"
                                Binding="{Binding IsEnabled}"
                                ElementStyle="{StaticResource GridCheckBoxStyle}"
                                EditingElementStyle="{StaticResource GridCheckBoxStyle}"
                                Header="On" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                ElementStyle="{StaticResource GridCellTextStyle}"
                                Header="Name"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding TriggerType}"
                                ElementStyle="{StaticResource GridCellTextStyle}"
                                Header="Trigger"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding MacroName}"
                                ElementStyle="{StaticResource GridCellTextStyle}"
                                Header="Action"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding LastResult}"
                                ElementStyle="{StaticResource GridCellTextStyle}"
                                Header="Last"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel
                        Grid.Row="2"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button Content="Pick AOI" Click="PickAoiButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Click="AddAoiButton_Click" Content="Add" />
                        <Button Click="UpdateAoiButton_Click" Content="Update" />
                        <Button Click="DeleteAoiButton_Click" Content="Delete" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Grid.ColumnSpan="3"
                Style="{StaticResource CoreWorkspaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Border
                        Background="#E9F8EF"
                        BorderBrush="#D9DEE6"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0">
                        <TextBlock
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="#008A3D"
                            Text="Targets / AOIs" />
                    </Border>
                    <Grid Grid.Row="1" Background="#F1F4F8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Text="On" />
                        <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Name" />
                        <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Title" />
                        <TextBlock Grid.Column="3" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Trigger" />
                        <TextBlock Grid.Column="4" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Action" />
                        <TextBlock Grid.Column="5" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Last" />
                    </Grid>
                    <TreeView
                        x:Name="WorkspaceTree"
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Padding="8,6"
                        BorderThickness="0"
                        MouseDoubleClick="WorkspaceTree_MouseDoubleClick"
                        SelectedItemChanged="WorkspaceTree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Padding" Value="5,2" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <SolidColorBrush
                                x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                Color="#DCEEFF" />
                            <SolidColorBrush
                                x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                Color="#163A59" />
                            <SolidColorBrush
                                x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                Color="#EDF3F8" />
                            <SolidColorBrush
                                x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                Color="#34495E" />
                            <HierarchicalDataTemplate DataType="{x:Type automation:TargetWindowProfile}" ItemsSource="{Binding Aois}">
                                <Border MinHeight="32" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActivationState}" Value="Active">
                                                    <Setter Property="Background" Value="#D9F2D9" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActivationState}" Value="Failed">
                                                    <Setter Property="Background" Value="#F8D7E3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <CheckBox Margin="2,0,8,0" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}" />
                                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Name}" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Run Text="[" />
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                            <Run Text="]" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type automation:AoiDefinition}" ItemsSource="{Binding DetailItems}">
                                <StackPanel MinHeight="32" VerticalAlignment="Center" Orientation="Horizontal">
                                    <CheckBox Margin="2,0,8,0" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}" />
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    <StackPanel
                        Grid.Row="3"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button Click="ActivateButton_Click" Content="Activate Target" />
                        <Button Click="RemoveTargetButton_Click" Content="Remove Target" />
                        <Button Click="PickAoiButton_Click" Content="Pick AOI" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Click="AddAoiButton_Click" Content="Add AOI" />
                        <Button Click="UpdateAoiButton_Click" Content="Update AOI" />
                        <Button Click="DeleteAoiButton_Click" Content="Delete AOI" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Grid.Column="4" Style="{StaticResource LegacyVisibilityStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0" />
                    <RowDefinition Height="0" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Padding="12" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="AOI:" />
                        <TextBox
                            x:Name="AoiNameTextBox"
                            Grid.Column="1"
                            Text="AOI 1" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="X" />
                        <TextBox
                            x:Name="AoiXTextBox"
                            Grid.Column="3"
                            Text="0" />
                        <TextBlock
                            Grid.Column="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Y" />
                        <TextBox
                            x:Name="AoiYTextBox"
                            Grid.Column="5"
                            Text="0" />
                        <TextBlock
                            Grid.Column="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="W" />
                        <TextBox
                            x:Name="AoiWidthTextBox"
                            Grid.Column="7"
                            Text="100" />
                        <TextBlock
                            Grid.Column="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="H" />
                        <TextBox
                            x:Name="AoiHeightTextBox"
                            Grid.Column="9"
                            Text="100" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            Background="#E9F8EF"
                            BorderBrush="#D9DEE6"
                            BorderThickness="0,0,0,1"
                            CornerRadius="6,6,0,0">
                            <TextBlock
                                Margin="12,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="#008A3D"
                                Text="Selected AOI Trigger / Action" />
                        </Border>
                        <Grid Grid.Row="1" Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="Trigger" />
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="TriggerTypeComboBox"
                                    Height="30"
                                    VerticalContentAlignment="Center"
                                    SelectedIndex="0">
                                    <ComboBoxItem Content="ImageMatch" />
                                    <ComboBoxItem Content="TextMatch" />
                                </ComboBox>
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="Threshold" />
                                <TextBlock
                                    x:Name="ThresholdText"
                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="0.90" />
                            </Grid>

                            <TextBlock
                                Grid.Row="2"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="Template" />
                            <Grid
                                Grid.Row="2"
                                Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="TemplateImagePathTextBox"
                                    Height="30"
                                    IsReadOnly="True" />
                                <Button
                                    Grid.Column="2"
                                    Margin="0"
                                    Click="BrowseImageButton_Click"
                                    Content="Browse" />
                                <Button
                                    Grid.Column="4"
                                    Margin="0"
                                    Click="CreatePatternButton_Click"
                                    Content="Create Pattern"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>

                            <TextBlock
                                Grid.Row="4"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="Confidence" />
                            <Slider
                                x:Name="ThresholdSlider"
                                Grid.Row="4"
                                Grid.Column="1"
                                Height="30"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="1.0"
                                Minimum="0.5"
                                TickFrequency="0.05"
                                ValueChanged="ThresholdSlider_ValueChanged"
                                Value="0.9" />

                            <TextBlock
                                Grid.Row="6"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="Action 설정" />
                            <Grid
                                Grid.Row="6"
                                Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="MacroComboBox"
                                    Height="30"
                                    DisplayMemberPath="Name"
                                    SelectedValuePath="Id"
                                    SelectionChanged="MacroComboBox_SelectionChanged" />
                                <Button
                                    Grid.Column="2"
                                    Margin="0"
                                    Click="ConfigureActionButton_Click"
                                    Content="Macros 관리"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                                <Button
                                    Grid.Column="4"
                                    Margin="0"
                                    Click="TestImageButton_Click"
                                    Content="Test AOI" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Background="#FFF6DE"
                            BorderBrush="#D9DEE6"
                            BorderThickness="0,0,0,1"
                            CornerRadius="6,6,0,0">
                            <TextBlock
                                Margin="12,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="#B77B00"
                                Text="Trigger Result" />
                        </Border>
                        <TextBox
                            x:Name="ImageResultTextBox"
                            Grid.Row="1"
                            Margin="12"
                            Height="Auto"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            AcceptsReturn="True"
                            Background="#FAFBFC"
                            IsReadOnly="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border
            Grid.Row="3"
            Background="#F7F9FC"
            BorderBrush="#CFD6E0"
            BorderThickness="0,1,0,0">
            <TextBlock
                x:Name="StatusText"
                Margin="14,0"
                VerticalAlignment="Center"
                Foreground="#4B5563"
                Text="Ready" />
        </Border>
    </Grid>
</Window>
