<Window x:Class="Automation.UI.MacroManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Macros" Width="960" Height="720" MinWidth="760" MinHeight="580"
 WindowStartupLocation="CenterOwner" Background="#EEF2F6" FontFamily="Consolas">
 <Window.Resources>
  <SolidColorBrush x:Key="PrimaryBrush" Color="#2F80C1"/>
  <Style TargetType="Button"><Setter Property="Height" Value="30"/><Setter Property="MinWidth" Value="86"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#C9D1DC"/></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1F6EA8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="6,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="30"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="StepCellText" TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Padding" Value="4,0"/>
  </Style>
 </Window.Resources>
 <Grid Margin="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="6" Padding="10">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontWeight="Bold" Text="Macro List" Margin="0,0,0,8"/>
    <ListBox x:Name="MacroList" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="MacroList_SelectionChanged"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
     <Button Content="Add" Click="AddMacro_Click"/><Button Content="Delete" Click="DeleteMacro_Click"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Column="2" Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="6" Padding="10">
   <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="130"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/><ColumnDefinition Width="54"/><ColumnDefinition Width="72"/><ColumnDefinition Width="54"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="MacroName" TextChanged="MacroName_TextChanged"/>
     <TextBlock Grid.Column="1" Text="반복 횟수" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <TextBox x:Name="RepeatCount" Grid.Column="2" Text="1" TextChanged="RepeatCount_TextChanged"/>
     <TextBlock Grid.Column="3" Text="간격(초)" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <TextBox x:Name="RepeatDelay" Grid.Column="4" Text="5" TextChanged="RepeatDelay_TextChanged"/>
     <Button Grid.Column="5" Width="90" Margin="8,0,0,0" Content="저장" Click="SaveMacros_Click"/>
     <Button x:Name="TestStartButton" Grid.Column="6" Width="110" Margin="8,0,0,0" Content="테스트 실행" Style="{StaticResource PrimaryButton}" Click="TestStart_Click"/>
     <Button x:Name="TestStopButton" Grid.Column="7" Width="90" Margin="8,0,0,0" Content="정지" IsEnabled="False" Click="TestStop_Click"/>
    </Grid>
    <DataGrid x:Name="StepGrid" Grid.Row="1" Margin="0,8" AutoGenerateColumns="False" IsReadOnly="True" MinRowHeight="32" RowHeight="32" SelectionChanged="StepGrid_SelectionChanged">
     <DataGrid.CellStyle>
      <Style TargetType="DataGridCell">
       <Setter Property="VerticalContentAlignment" Value="Center"/>
       <Setter Property="Padding" Value="0"/>
      </Style>
     </DataGrid.CellStyle>
     <DataGrid.RowStyle>
      <Style TargetType="DataGridRow">
       <Setter Property="VerticalContentAlignment" Value="Center"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding IsExecuting}" Value="True">
         <Setter Property="Background" Value="#C8F7C5"/>
         <Setter Property="FontWeight" Value="Bold"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </DataGrid.RowStyle>
     <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Type}" Width="120" ElementStyle="{StaticResource StepCellText}"/><DataGridTextColumn Header="Step" Binding="{Binding Summary}" Width="*" ElementStyle="{StaticResource StepCellText}"/></DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="StepType" SelectionChanged="StepType_SelectionChanged"><ComboBoxItem Content="Hotkey"/><ComboBoxItem Content="TextInput"/><ComboBoxItem Content="MouseClick"/><ComboBoxItem Content="Delay"/><ComboBoxItem Content="FindWindow"/><ComboBoxItem Content="RunProgram"/><ComboBoxItem Content="ActivateWindow"/><ComboBoxItem Content="Screenshot"/></ComboBox>
     <ComboBox x:Name="StepCondition" Grid.Column="1" Margin="8,0"><ComboBoxItem Content="항상 실행" Tag="Always"/><ComboBoxItem Content="이전 단계 OK" Tag="PreviousOk"/><ComboBoxItem Content="이전 단계 NG" Tag="PreviousNg"/></ComboBox>
     <TextBox x:Name="StepValue" Grid.Column="2" Margin="8,0" ToolTip="키 조합, 텍스트, 창 제목, 실행 파일 또는 X,Y"/>
     <ComboBox x:Name="HotkeyList" Grid.Column="2" Margin="8,0" Visibility="Collapsed" SelectionChanged="HotkeyList_SelectionChanged">
      <ComboBoxItem Content="바탕 화면 표시 (WIN+D)" Tag="WIN+D"/><ComboBoxItem Content="파일 탐색기 (WIN+E)" Tag="WIN+E"/>
      <ComboBoxItem Content="실행 창 (WIN+R)" Tag="WIN+R"/><ComboBoxItem Content="화면 잠금 (WIN+L)" Tag="WIN+L"/>
      <ComboBoxItem Content="창 닫기 (ALT+F4)" Tag="ALT+F4"/><ComboBoxItem Content="창 전환 (ALT+TAB)" Tag="ALT+TAB"/>
      <ComboBoxItem Content="작업 관리자 (CTRL+SHIFT+ESC)" Tag="CTRL+SHIFT+ESC"/>
      <ComboBoxItem Content="복사 (CTRL+C)" Tag="CTRL+C"/><ComboBoxItem Content="붙여넣기 (CTRL+V)" Tag="CTRL+V"/>
      <ComboBoxItem Content="잘라내기 (CTRL+X)" Tag="CTRL+X"/><ComboBoxItem Content="실행 취소 (CTRL+Z)" Tag="CTRL+Z"/>
      <ComboBoxItem Content="다시 실행 (CTRL+Y)" Tag="CTRL+Y"/><ComboBoxItem Content="전체 선택 (CTRL+A)" Tag="CTRL+A"/>
      <ComboBoxItem Content="저장 (CTRL+S)" Tag="CTRL+S"/><ComboBoxItem Content="찾기 (CTRL+F)" Tag="CTRL+F"/>
      <ComboBoxItem Content="새로 고침 (F5)" Tag="F5"/><ComboBoxItem Content="확인 (ENTER)" Tag="ENTER"/>
      <ComboBoxItem Content="취소 (ESC)" Tag="ESC"/><ComboBoxItem Content="다음 항목 (TAB)" Tag="TAB"/>
      <ComboBoxItem Content="직접 입력" Tag="CUSTOM"/>
     </ComboBox>
     <ComboBox x:Name="ClickModeList" Grid.Column="2" Margin="8,0" Visibility="Collapsed" SelectionChanged="ClickModeList_SelectionChanged">
      <ComboBoxItem Content="InProgram (현재 AOI 중앙 클릭)" Tag="InProgram"/>
      <ComboBoxItem Content="Target 좌표 직접 입력 (X,Y)" Tag="Coordinates"/>
     </ComboBox>
     <TextBox x:Name="StepDelay" Grid.Column="3" Text="1000" ToolTip="대기시간(ms)"/>
     <Button x:Name="BrowseProgramButton" Grid.Column="4" Content="Browse" Click="BrowseProgram_Click" Visibility="Collapsed"/>
     <Button x:Name="CheckWindowButton" Grid.Column="4" Content="Check" Click="CheckWindow_Click" Visibility="Collapsed"/>
     <Button x:Name="SetClickAoiButton" Grid.Column="4" Content="Set AOI" Click="SetClickAoi_Click" Visibility="Collapsed"/>
    </Grid>
    <TextBlock x:Name="StepHelp" Grid.Row="3" Margin="0,8,0,0" Foreground="#526173" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
     <Button Content="Add Step" Click="AddStep_Click"/><Button Content="Update Step" Click="UpdateStep_Click"/><Button Content="Delete Step" Click="DeleteStep_Click"/><Button Content="▲" Click="MoveUp_Click"/><Button Content="▼" Click="MoveDown_Click"/>
    </StackPanel>
    <GroupBox Grid.Row="5" Header="Macro Test Log" Margin="0,8,0,0">
     <TextBox x:Name="MacroTestLog" Height="Auto" Margin="6" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </GroupBox>
   </Grid>
  </Border>
 </Grid>
</Window>
