<Window x:Class="Automation.UI.OfflineImageValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Offline Image Capture &amp; AOI Validation"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        Background="#EEF2F6"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#2C4056" Padding="14" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Offline Image Capture &amp; AOI Validation" Foreground="White" FontSize="17" FontWeight="Bold" />
                <TextBlock Text="Image File → Preview → AOI → Crop → Crop Preview" Foreground="#B9C7D7" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Width="120" Height="32" Content="Select Image..." Click="SelectImageButton_Click" />
            <TextBox x:Name="ImagePathTextBox" Grid.Column="1" Margin="8,0" Padding="7,4" IsReadOnly="True" VerticalContentAlignment="Center" />
            <Button x:Name="SelectAoiButton" Grid.Column="2" Width="110" Height="32" Content="Select AOI" Click="SelectAoiButton_Click" IsEnabled="False" />
            <Button x:Name="CropButton" Grid.Column="3" Width="110" Height="32" Margin="8,0,0,0" Content="Crop Preview" Click="CropButton_Click" IsEnabled="False" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="12,0" VerticalAlignment="Center" Text="Source Preview (aspect ratio preserved)" FontWeight="Bold" />
                    <Border Grid.Row="1" Margin="8" Background="#111827">
                        <Image x:Name="SourcePreviewImage" Stretch="Uniform" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="12,0" VerticalAlignment="Center" Text="Crop Preview" FontWeight="Bold" />
                    <Border Grid.Row="1" Margin="8" Background="#111827">
                        <Image x:Name="CropPreviewImage" Stretch="Uniform" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="ImageInfoText" Text="Image: none" Foreground="#4B5563" />
                <TextBlock x:Name="AoiInfoText" Text="AOI: none" Margin="0,4,0,0" FontWeight="Bold" Foreground="#2F80C1" />
            </StackPanel>
            <Button Grid.Column="1" Width="88" Height="30" Content="Close" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
