<Window x:Class="Automation.UI.UserGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automation Framework User Guide"
        Width="760"
        Height="560"
        MinWidth="680"
        MinHeight="480"
        Background="#EEF2F6"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="GuideTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#263445" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="GuideSectionStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#0068B7" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#2C4056" Padding="14" CornerRadius="6" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Automation Framework User Guide" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0" />
                <TextBlock Text="Target Program + Multi AOI Trigger Actions" Foreground="#B9C7D7" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="6">
            <TabControl Margin="8">
                <TabItem Header="Quick Start">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GuideTitleStyle}" Text="빠른 사용 순서" />
                            <TextBlock Text="1. Refresh를 눌러 현재 실행 중인 창 목록을 새로고침합니다." />
                            <TextBlock Text="2. Target Window 목록에서 자동화할 프로그램 창을 선택합니다." />
                            <TextBlock Text="3. Activate를 눌러 선택한 프로그램을 앞으로 가져옵니다." />
                            <TextBlock Text="4. AOI List에서 AOI를 선택하거나 Add로 새 AOI를 추가합니다." />
                            <TextBlock Text="5. 오른쪽에서 AOI 이름, X/Y/W/H, Trigger, Action을 설정합니다." />
                            <TextBlock Text="6. AOI 좌표는 직접 입력하거나 Pick AOI로 Target 캡처 화면에서 드래그합니다." />
                            <TextBlock Text="7. Update로 AOI 설정을 저장합니다." />
                            <TextBlock Text="8. Test AOI로 선택 AOI만 검사하거나 Start로 켜진 AOI 전체를 감시합니다." />
                            <TextBlock Style="{StaticResource GuideSectionStyle}" Text="핵심 개념" />
                            <TextBlock Text="AOI는 단순 사각형이 아니라, 자기 Trigger와 자기 Action을 가진 독립 작업 단위입니다." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Target Program">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GuideTitleStyle}" Text="Target Program 사용법" />
                            <TextBlock Text="Target Window는 자동화 기준이 되는 프로그램 창입니다." />
                            <TextBlock Text="AOI 좌표는 선택한 프로그램 창의 좌상단을 기준으로 계산됩니다." />
                            <TextBlock Style="{StaticResource GuideSectionStyle}" Text="버튼" />
                            <TextBlock Text="Refresh: 현재 열려 있는 창 목록을 다시 불러옵니다." />
                            <TextBlock Text="Activate: 선택한 창을 앞으로 가져옵니다." />
                            <TextBlock Text="Capture: 선택한 창 전체를 캡처 파일로 저장합니다." />
                            <TextBlock Style="{StaticResource GuideSectionStyle}" Text="주의" />
                            <TextBlock Text="창 위치가 바뀌어도 AOI는 창 기준 상대 좌표로 쓰는 방향입니다. 단, 현재 버전은 창 테두리/타이틀바 포함 좌표라 테스트하면서 보정이 필요할 수 있습니다." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="AOI Rules">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GuideTitleStyle}" Text="AOI 설정법" />
                            <TextBlock Text="AOI는 Area Of Interest, 관심 영역입니다. 자동화할 프로그램 안에서 감시할 사각형 영역입니다." />
                            <TextBlock Style="{StaticResource GuideSectionStyle}" Text="좌표" />
                            <TextBlock Text="X: 대상 창 기준 왼쪽에서 떨어진 거리" />
                            <TextBlock Text="Y: 대상 창 기준 위쪽에서 떨어진 거리" />
                            <TextBlock Text="W: AOI 너비" />
                            <TextBlock Text="H: AOI 높이" />
                            <TextBlock Style="{StaticResource GuideSectionStyle}" Text="AOI 목록" />
                            <TextBlock Text="On 체크: Start 감시 때 이 AOI를 검사할지 선택합니다." />
                            <TextBlock Text="Add: 현재 오른쪽 입력값으로 새 AOI를 추가합니다." />
                            <TextBlock Text="Update: 선택한 AOI에 오른쪽 입력값을 반영합니다." />
                            <TextBlock Text="Pick AOI: 선택한 Target 창을 캡처한 뒤 드래그로 AOI 영역을 지정합니다. 지정된 X/Y/W/H가 자동 입력됩니다." />
                            <TextBlock Text="Delete: 선택한 AOI를 삭제합니다." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Triggers">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GuideTitleStyle}" Text="Trigger 사용법" />
                            <TextBlock Text="Trigger는 AOI 안에서 조건이 만족됐는지 판단하는 기능입니다." />
                            <TextBlock Style="{StaticResource GuideSectionStyle}" Text="ImageMatch" />
                            <TextBlock Text="Browse로 기준 이미지를 등록합니다." />
                            <TextBlock Text="Confidence Threshold 값을 정합니다. 0.90이면 90% 이상 비슷해야 발동합니다." />
                            <TextBlock Text="Test AOI를 누르면 선택 AOI 안에서 기준 이미지를 한 번 검색합니다." />
                            <TextBlock Text="Start를 누르면 On 체크된 AOI들을 1초마다 반복 검사합니다." />
                            <TextBlock Style="{StaticResource GuideSectionStyle}" Text="TextMatch" />
                            <TextBlock Text="문자열/OCR 트리거 자리만 준비되어 있습니다. OCR 엔진과 사용자 폰트 학습은 다음 단계에서 구현합니다." />
                            <TextBlock Style="{StaticResource GuideSectionStyle}" Text="결과" />
                            <TextBlock Text="Trigger Result에는 매칭 성공 여부, 매칭율, AOI 좌표, 액션 실행 결과가 표시됩니다." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Actions">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GuideTitleStyle}" Text="Action 사용법" />
                            <TextBlock Text="Action은 Trigger가 발생했을 때 실행되는 동작입니다. AOI마다 다르게 설정할 수 있습니다." />
                            <TextBlock Style="{StaticResource GuideSectionStyle}" Text="None" />
                            <TextBlock Text="조건만 검사하고 아무 동작도 하지 않습니다. 테스트할 때 안전합니다." />
                            <TextBlock Style="{StaticResource GuideSectionStyle}" Text="MouseClick" />
                            <TextBlock Text="Trigger가 발생하면 선택한 대상 프로그램을 활성화한 뒤 해당 AOI 중앙을 클릭합니다." />
                            <TextBlock Style="{StaticResource GuideSectionStyle}" Text="KeyInput" />
                            <TextBlock Text="Trigger가 발생하면 선택한 대상 프로그램에 Key/Text 입력칸의 내용을 입력합니다." />
                            <TextBlock Style="{StaticResource GuideSectionStyle}" Text="주의" />
                            <TextBlock Text="MouseClick과 KeyInput은 실제 입력을 발생시키므로, 처음에는 Action을 None으로 두고 Test AOI부터 확인하는 것이 좋습니다." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Width="92" Height="30" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
